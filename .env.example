# Sao chép file này thành .env ở thư mục gốc:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# File .env không được commit. Lấy giá trị thật từ team hoặc từ
# Google Cloud Console / Cloudinary Dashboard.

# Backend API (mặc định: môi trường production trên Render)
API_BASE_URL=https://boardverse-server.onrender.com

# ─── Google Sign-In (Web) ────────────────────────────────────────────────────
# OAuth 2.0 Client ID loại "Web application".
# Authorized JavaScript origins phải gồm origin đang chạy (vd: http://localhost).
GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com

# ─── Google Sign-In (Android & iOS — serverClientId) ─────────────────────────
# Cũng là Web OAuth Client ID. Plugin google_sign_in dùng giá trị này
# làm serverClientId để lấy idToken gửi backend.
GOOGLE_SERVER_CLIENT_ID=xxx.apps.googleusercontent.com

# ─── Google Sign-In (iOS native) ─────────────────────────────────────────────
# OAuth 2.0 Client ID loại "iOS". Bundle ID: com.boardverse.boardverseMobile
GOOGLE_IOS_CLIENT_ID=xxx.apps.googleusercontent.com

# ─── Cloudinary (upload ảnh đại diện) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_DEFAULT_FOLDER=boardverse/uploads
CLOUDINARY_AUTO_OPTIMIZE=true
